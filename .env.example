# ============================================================
# Dify 环境变量模板（已脱敏，无真实 Key）
# 使用方法：复制本文件为 .env，然后填入你自己的配置
#   cp .env.example .env
# 注意：.env 已加入 .gitignore，不会被提交到 Git
# ============================================================

# ------------------------------------------------------------
# 核心服务 URL
# 本地部署时，将端口改为你实际使用的端口（默认 8080，避免 80 端口冲突）
# ------------------------------------------------------------
CONSOLE_API_URL=http://localhost:8080
SERVER_CONSOLE_API_URL=http://api:5001
CONSOLE_WEB_URL=http://localhost:8080
SERVICE_API_URL=http://localhost:8080
TRIGGER_URL=http://localhost:8080
APP_API_URL=http://localhost:8080
APP_WEB_URL=http://localhost:8080
FILES_URL=http://localhost:8080
INTERNAL_FILES_URL=
ENDPOINT_URL_TEMPLATE=http://localhost:8080/e/{hook_id}
NEXT_PUBLIC_SOCKET_URL=ws://localhost:8080

# ------------------------------------------------------------
# 对外暴露端口
# Dify 默认使用 80 端口，Windows 上建议改为 8080 避免冲突
# ------------------------------------------------------------
EXPOSE_NGINX_PORT=8080
EXPOSE_SSL_PORT=8443

# ------------------------------------------------------------
# 大模型 API Key（重要：填入你自己的 Key，不要提交到 Git）
# 以下仅为示例格式，不是真实 Key
# ------------------------------------------------------------

# DeepSeek API Key（在 https://platform.deepseek.com/ 申请）
# 格式：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI API Key（如使用 OpenAI 兼容接口）
# OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI 兼容自定义接口（如使用中转服务、本地模型等）
# 示例：CC-Switch 本地代理 http://host.docker.internal:15721/v1
# 注意：Docker 容器内访问宿主机需用 host.docker.internal，不能用 127.0.0.1
# OPENAI_API_BASE=http://host.docker.internal:15721/v1

# ------------------------------------------------------------
# 运行时与安全
# ------------------------------------------------------------
LANG=C.UTF-8
LC_ALL=C.UTF-8

# 密钥（首次部署自动生成，不要修改）
SECRET_KEY=replace-with-a-random-secret-key

# ------------------------------------------------------------
# 数据库配置（本地开发用默认值即可，生产环境请修改密码）
# ------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------
# 向量数据库配置（Dify 内置，默认 weaviate）
# 可选：weaviate / qdrant / milvus / pgvector
# ------------------------------------------------------------
VECTOR_STORE=weaviate

# ------------------------------------------------------------
# 存储配置（本地开发用本地存储，生产环境建议用 S3/OSS）
# ------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/api/storage

# ------------------------------------------------------------
# 日志级别
# ------------------------------------------------------------
LOG_LEVEL=INFO
